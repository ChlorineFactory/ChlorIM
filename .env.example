# ChiorIM 生产部署配置示例（复制为 .env 后按需修改）
PORT=3000

# 反向代理 HTTPS 域名（逗号分隔多个 Origin）
CORS_ORIGINS=http://localhost:3000

# HTTPS 反向代理时设为 true
COOKIE_SECURE=false

# 外部客户端连接本地 Bridge 时使用的 WebSocket 地址（例如 wss://chat.example.com）
BRIDGE_PUBLIC_URL=

# 单文件上传上限（默认 10 MiB）
UPLOAD_MAX_BYTES=10485760

# 上传文件默认鉴权；如需公开缓存设为 true
PUBLIC_UPLOADS=false

# 可选：自定义 Provider 密钥加密盐（留空则自动生成在 /data/.secret）
APP_SECRET=
