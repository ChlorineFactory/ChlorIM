{
  "name": "chiorim",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@10.32.1",
  "scripts": {
    "dev:server": "tsx watch --conditions=development apps/server/src/index.ts",
    "build": "tsc -b && node -e \"require('node:fs').chmodSync('packages/bridge/dist/cli.js', 0o755); require('node:fs').chmodSync('packages/mcp/dist/cli.js', 0o755)\" && pnpm --filter @chiorim/web build && node scripts/compress-web.mjs apps/web/dist",
    "build:binaries": "pnpm build && node scripts/build-binaries.mjs",
    "docker:build": "docker build -t chiorim:latest .",
    "typecheck": "tsc -p tsconfig.check.json && pnpm --filter @chiorim/web typecheck",
    "test": "vitest run",
    "dev:web": "pnpm --filter @chiorim/web dev",
    "dev": "concurrently --kill-others --names server,web \"pnpm dev:server\" \"pnpm dev:web\""
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "@types/ws": "^8.5.14",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3",
    "vitest": "^3.2.0",
    "ws": "^8.18.2",
    "concurrently": "^9.2.0"
  }
}
